{
  "name": "stream-multiview",
  "productName": "Stream Multiview",
  "version": "0.3.2",
  "updateRepo": "GlowingPear/stream-window-multiview",
  "description": "Watch several Kick, Twitch and YouTube streams and chats at once.",
  "author": "GlowingPear",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/GlowingPear/stream-window-multiview",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "node src/harden.js && electron .",
    "dev": "node scripts/dev.js",
    "worktree": "node scripts/worktree.js",
    "test": "node --test --test-force-exit --test-timeout=60000 \"test/unit/*.test.js\"",
    "test:ui": "node --test --test-force-exit --test-timeout=120000 \"test/ui/*.test.js\"",
    "test:launch": "node --test --test-force-exit --test-timeout=120000 \"test/launch/*.test.js\"",
    "test:launch:hidden": "node --test --test-force-exit --test-timeout=120000 \"test/launch/*.test.js\"",
    "test:all": "npm test && npm run test:ui && npm run test:launch",
    "test:coverage": "node scripts/coverage.js",
    "test:coverage:hidden": "node scripts/coverage.js",
    "test:setup": "npm install --no-save playwright@1.56.1 && npx playwright install chromium",
    "dist:win": "npx --yes electron-builder@25.1.8 --win --publish never",
    "dist:mac": "npx --yes electron-builder@25.1.8 --mac --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0"
  },
  "build": {
    "appId": "com.glowingpear.streammultiview",
    "productName": "Stream Multiview",
    "copyright": "Copyright © 2026 GlowingPear",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist{,/**/*}",
      "!build{,/**/*}",
      "!.github{,/**/*}",
      "!.claude{,/**/*}",
      "!.worktrees{,/**/*}",
      "!scripts{,/**/*}",
      "!test{,/**/*}",
      "!*.bat",
      "!*.sh",
      "!README*",
      "!.needs-install",
      "!*.log"
    ],
    "asarUnpack": [
      "*.txt",
      "CHANGELOG.md"
    ],
    "afterPack": "build/after-pack.js",
    "afterSign": "build/after-sign.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stream Multiview",
      "runAfterFinish": true,
      "artifactName": "Stream-Multiview-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Stream-Multiview-${version}-mac.${ext}",
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Stream-Multiview-${version}-mac.${ext}",
      "title": "Stream Multiview ${version}"
    },
    "publish": null
  },
  "dependencies": {
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0"
  }
}
