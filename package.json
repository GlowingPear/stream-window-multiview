{
  "name": "stream-multiview",
  "productName": "Stream Multiview",
  "version": "0.4.9",
  "updateRepo": "GlowingPear/stream-window-multiview",
  "description": "Watch several Kick, Twitch and YouTube streams and chats at once.",
  "author": "GlowingPear",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/GlowingPear/stream-window-multiview",
  "grapevine": {
    "app": "com.glowingpear.streammultiview",
    "provides": {
      "players": "1.0"
    },
    "uses": {
      "drops.farming": "1.0",
      "rewards.daily": "1.0"
    }
  },
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "node src/main/harden.js && electron .",
    "dev": "node scripts/dev.js",
    "worktree": "node scripts/worktree.js",
    "test": "node --test --test-force-exit --test-timeout=60000 \"test/unit/**/*.test.js\"",
    "test:ui": "node --test --test-force-exit --test-timeout=120000 \"test/ui/**/*.test.js\"",
    "test:launch": "node --test --test-force-exit --test-timeout=120000 \"test/launch/**/*.test.js\"",
    "test:launch:hidden": "node --test --test-force-exit --test-timeout=120000 \"test/launch/**/*.test.js\"",
    "test:all": "npm test && npm run test:ui && npm run test:launch",
    "test:coverage": "node scripts/coverage.js",
    "test:coverage:hidden": "node scripts/coverage.js",
    "test:setup": "npm install --no-save playwright@1.56.1 && npx playwright install chromium && node node_modules/electron/install.js",
    "visual-diff": "node scripts/visual-diff.js",
    "page-imports": "node scripts/page-imports.js",
    "dist:win": "npx --yes electron-builder@26.15.3 --win --publish never",
    "dist:mac": "npx --yes electron-builder@26.15.3 --mac --publish never",
    "check:commands": "node scripts/check-chat-commands.js",
    "grapevine:check": "grapevine-check"
  },
  "devDependencies": {
    "electron": "^45.0.0"
  },
  "build": {
    "appId": "com.glowingpear.streammultiview",
    "productName": "Stream Multiview",
    "copyright": "Copyright © 2026 GlowingPear",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist{,/**/*}",
      "!build{,/**/*}",
      "!.github{,/**/*}",
      "!.claude{,/**/*}",
      "!.worktrees{,/**/*}",
      "!scripts{,/**/*}",
      "!test{,/**/*}",
      "!*.bat",
      "!*.sh",
      "!README*",
      "!CLAUDE.md",
      "!src/page/README.md",
      "!.needs-install",
      "!*.log"
    ],
    "asarUnpack": [
      "*.txt",
      "CHANGELOG.md"
    ],
    "afterPack": "build/after-pack.js",
    "afterSign": "build/after-sign.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stream Multiview",
      "runAfterFinish": true,
      "artifactName": "Stream-Multiview-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Stream-Multiview-${version}-mac.${ext}",
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Stream-Multiview-${version}-mac.${ext}",
      "title": "Stream Multiview ${version}"
    },
    "publish": null
  },
  "dependencies": {
    "@streamorchard/grapevine": "^0.11.2",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
