{
  "manifest_version": 3,
  "name": "Test Marker",
  "version": "1.2.3",
  "description": "Marks every page it runs on, for the app's tests.",
  "content_scripts": [{ "matches": ["https://*/*"], "js": ["mark.js"], "run_at": "document_start", "all_frames": true }],
  "permissions": ["storage", "tabCapture"],
  "action": { "default_popup": "popup.html", "default_title": "Test Marker" },
  "options_page": "options.html",
  "icons": { "32": "icon.png" }
}
